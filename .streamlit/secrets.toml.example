# Example secrets for deploying the web app on Streamlit Community Cloud.
# Do NOT put real values in this file. On share.streamlit.io: your app -> Settings -> Secrets,
# paste these lines with your real values. (Locally, keep using the .env file instead.)
# Root-level secrets are also exposed as environment variables, so the app reads them unchanged.

GOOGLE_API_KEY = "your_key_here"
APP_PASSWORD = "choose_a_password"     # strongly recommended for a public URL: protects your API quota

# Optional LangSmith tracing
# LANGSMITH_TRACING = "true"
# LANGSMITH_API_KEY = "your_langsmith_key_here"
# LANGSMITH_PROJECT = "text2sql"
