# Copy this file to .env and put your real key there. Never commit .env.
GOOGLE_API_KEY=your_key_here

# --- Optional: LangSmith tracing (Phase 6.3) ---
# Free account at https://smith.langchain.com -> Settings -> API Keys. Then remove the # below.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_key_here
# LANGSMITH_PROJECT=text2sql

# --- Optional: password-protect the web app (Phase 6.6, recommended before deploying) ---
# APP_PASSWORD=choose_a_password
